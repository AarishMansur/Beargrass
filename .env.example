# --- Hermes / LLM harness (any OpenAI-compatible endpoint works) ---
# OpenRouter: https://openrouter.ai/api/v1
# Ollama:     http://localhost:11434/v1   (api key can be "ollama")
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nousresearch/hermes-3-llama-3.1-405b

# --- Location defaults used by the local trigger client ---
DEFAULT_LAT=40.7128
DEFAULT_LON=-74.0060
SCREEN_TIME_THRESHOLD_MIN=120
TRIGGER_ENDPOINT=http://127.0.0.1:8000/api/v1/trigger

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
DEBUG=false

# Answer with a deterministic OSM-backed plan when no LLM key is set.
ALLOW_OFFLINE_PLANNER=true

# --- OpenStreetMap (free & keyless; fair-use limits apply) ---
OSM_USER_AGENT=TouchGrassAgent/1.0 (open-source hackathon project)
OSM_NEARBY_RADIUS_M=1500
OSM_CACHE_TTL_SECONDS=300
